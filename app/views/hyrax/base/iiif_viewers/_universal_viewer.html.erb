<div class="viewer-wrapper">
  <%# override uv_search_param inline: use params for query value, instead of blacklight Search record %>

  <% manifest_url = main_app.polymorphic_url [main_app, :manifest, presenter],
                                             { format: :json,
                                               locale: nil,
                                               config: universal_viewer_config_url,
                                               q: params['query'].present? ? "&q=#{url_encode(params['query'])}" : nil
                                             }
  %>

  <iframe
    id="uv-iframe"
    title="IIIF Viewer displaying <%= presenter.title.join(';') %>"
    src="<%= universal_viewer_base_url %>"
    data-manifest="<%= manifest_url %>"
    allowfullscreen="true"
    frameborder="0"
  ></iframe>
</div>
